    --azul: #1f4e79;
    --azul-claro: #dce8f4;
    --borde: #c9d4df;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fondo: #141a21;
      --texto: #e8edf2;
      --apagado: #9fb0c0;
      --azul: #7fb2e5;
      --azul-claro: #1f2c3a;
