  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    background: var(--fondo);
    color: var(--texto);
    line-height: 1.7;
  }
  nav {
    background: var(--azul-claro);
    border-bottom: 1px solid var(--borde);
    padding: 0.75rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    justify-content: center;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 0.95rem;
  }
  nav a { color: var(--azul); text-decoration: none; padding: 0.15rem 0; border-bottom: 2px solid transparent; }
  nav a:hover, nav a:focus-visible, nav a.activo { border-bottom-color: var(--azul); outline: none; }
  header { text-align: center; padding: 4rem 1.25rem 2.5rem; }
  header h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin: 0 0 0.75rem; line-height: 1.1; color: var(--azul); }
  header p { margin: 0.2rem 0; color: var(--apagado); font-size: 1.1rem; }
  header .nombre { color: var(--texto); font-size: 1.25rem; }
  main { max-width: 42rem; margin: 0 auto; padding: 0 1.25rem 4rem; }
  h2 { font-size: 1.8rem; margin: 1rem 0 0.75rem; color: var(--azul); }
  .contacto { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--borde); font-family: system-ui, sans-serif; }
  .contacto p { margin: 0.4rem 0; }
  .contacto a { color: var(--azul); word-break: break-all; }
  a:focus-visible { outline: 2px solid var(--azul); outline-offset: 2px; }
  footer { text-align: center; color: var(--apagado); font-family: system-ui, sans-serif; font-size: 0.85rem; padding: 1.5rem; border-top: 1px solid var(--borde); }
</style>
